PORT=5001
# Atlas > Database > Connect > Drivers. Replace <username>/<password>.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=careerrite
# Any long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Frontend origin(s) allowed by CORS (comma separated)
CLIENT_URL=http://localhost:3000
# Optional: only if you get "querySrv ECONNREFUSED"
# DNS_SERVERS=8.8.8.8,1.1.1.1
